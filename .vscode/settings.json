{

  "window.restoreWindows": "all",
  "files.hotExit": "onExitAndWindowClose"
  // 啟用 Copilot Labs（進階功能）
  "github.copilot.enable": true,
  "github.copilot.chat.references.enabled": true,
  "github.copilot.chat.customInstructionsInSystemMessage": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.enableChat": true,
  "copilot.experimental.chat": "enabled",
  "python.testing.pytestArgs": [
    "Python"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  // Token spent optimization settings
  "chat.tools.compressOutput.enabled": true,
  "github.copilot.chat.agent.backgroundTodoAgent.enabled": true,
  "responsesApi.toolSearchTool.enabled": true,
  "github.copilot.chat.anthropic.cacheBreakpoints.lastTwoMessages": true
}